# Neon Postgres (with pgvector extension enabled)
DATABASE_URL=

# ── Agent runtime (agent/) ──
# All optional — without them the agent loop runs against mocks.

# Claude (Anthropic) for attestation reasoning
ANTHROPIC_API_KEY=

# Apify Actors for real onchain scraping (free tier at apify.com)
APIFY_TOKEN=
APIFY_ACTOR_ID_OUTPUT_WATCHER=
APIFY_ACTOR_ID_CROSS_REFERENCE=

# Pinata IPFS pinning (free tier at pinata.cloud)
PINATA_JWT=

# ── Platform ENS provisioning (server-signed flow) ──
# These three are required for the launch wizard to register subnames
# under ethesis.eth on the user's behalf. The platform wallet must own
# PLATFORM_ENS_NAME and have testnet ETH for gas.

# Parent ENS name owned by the platform wallet (e.g. ethesis.eth)
PLATFORM_ENS_NAME=ethesis.eth

# Private key of the wallet that owns PLATFORM_ENS_NAME on PLATFORM_ENS_CHAIN.
# Use a hot wallet — never reuse mainnet keys.
PLATFORM_ENS_OWNER_PRIVATE_KEY=

# Master seed used to derive each venture's agent EOA. Long random string.
AGENT_MASTER_SEED=

# Where the platform wallet provisions: "sepolia" (default, free) | "mainnet"
PLATFORM_ENS_CHAIN=sepolia

# Public-facing copy of PLATFORM_ENS_NAME so client previews show the right
# parent without needing the private vars.
NEXT_PUBLIC_PLATFORM_ENS_NAME=ethesis.eth

# (Legacy NameStone fields — unused; the platform-signed flow above replaces them)
NAMESTONE_API_KEY=
NAMESTONE_DOMAIN=ethesis.eth

# Onchain
RPC_URL=

# Optional viem RPC overrides for live ENS reads on the venture page.
# If unset, viem uses public defaults (rate-limited but functional).
NEXT_PUBLIC_MAINNET_RPC=
NEXT_PUBLIC_SEPOLIA_RPC=

# Which chain the launch wizard provisions ENS subnames on.
# "sepolia" (default) — Sepolia ENS, free testnet ETH from faucets
# "mainnet"           — real ENS, real gas (~$5-10/launch at busy times)
NEXT_PUBLIC_ENS_CHAIN=sepolia

# WalletConnect / Reown — get a free projectId at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Umia backend — "mock" (default) or "live". Live impl in lib/umia.ts is a
# stub that throws; flip to "live" only after Umia ships an SDK and live
# implementations are wired against their contracts.
NEXT_PUBLIC_UMIA_BACKEND=mock

# Agent runtime
AGENT_MASTER_SEED=
TREASURY_DEPLOYER_PRIVATE_KEY=

# Auth (SIWE)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Embeddings (OpenAI text-embedding-3-small or Voyage-2)
EMBEDDING_PROVIDER_KEY=
