# Neon Postgres (with pgvector extension enabled)
DATABASE_URL=

# LLM
ANTHROPIC_API_KEY=

# Apify
APIFY_TOKEN=
APIFY_ACTOR_ID_OUTPUT_WATCHER=
APIFY_ACTOR_ID_CROSS_REFERENCE=

# IPFS pinning
PINATA_JWT=

# ENS subname provisioning (NameStone)
NAMESTONE_API_KEY=
NAMESTONE_DOMAIN=ethesis.eth

# Onchain
RPC_URL=

# Optional viem RPC overrides for live ENS reads on the venture page.
# If unset, viem uses public defaults (rate-limited but functional).
NEXT_PUBLIC_MAINNET_RPC=
NEXT_PUBLIC_SEPOLIA_RPC=

# Which chain the launch wizard provisions ENS subnames on.
# "mainnet" (default) — real ENS, real gas (~$10/launch at busy times)
# "sepolia"           — Sepolia ENS, free testnet ETH from faucets
NEXT_PUBLIC_ENS_CHAIN=mainnet

# WalletConnect / Reown — get a free projectId at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Umia backend — "mock" (default) or "live". Live impl in lib/umia.ts is a
# stub that throws; flip to "live" only after Umia ships an SDK and live
# implementations are wired against their contracts.
NEXT_PUBLIC_UMIA_BACKEND=mock

# Agent runtime
AGENT_MASTER_SEED=
TREASURY_DEPLOYER_PRIVATE_KEY=

# Auth (SIWE)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Embeddings (OpenAI text-embedding-3-small or Voyage-2)
EMBEDDING_PROVIDER_KEY=
