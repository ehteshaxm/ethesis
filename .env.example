# Frontend-only demo build — no env vars required.
#
# The optional variable below enables real WalletConnect (mobile QR code
# scanning). Without it, injected & Coinbase connectors still work fine.
# Get a free projectId at https://cloud.reown.com.

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: display name for the parent ENS shown by the launch wizard.
# Defaults to "ethesis.eth".
NEXT_PUBLIC_PLATFORM_ENS_NAME=ethesis.eth
